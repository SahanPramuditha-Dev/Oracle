# Keep actual credentials in backend/.env, which is ignored by Git.
AI_PROVIDER=ollama
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=moondream
OLLAMA_BASE_URL=http://127.0.0.1:11434

GEMINI_ENABLED=false
# Optional self-hosted search; JSON format must be enabled in SearXNG.
# Leave blank if no local instance is running. No public-instance fallback.
ORACLE_SEARXNG_URL=
# Non-secret identifier only; the OAuth client file stays at backend/google-client.json (ignored).
ORACLE_GOOGLE_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
ORACLE_ALLOWED_APPS=
ORACLE_DATABASE_URL=
# Provision with scripts/manage_postgres.py --provision; migrate/activate with scripts/migrate_records.py --activate.
# Keep the actual PostgreSQL connection URL server-side. Blank retains SQLite for compatibility.
# Optional comma separated executable names approved for launch; no paths or arguments.
# The separate local gateway credential is generated in data/dev/api-token.
