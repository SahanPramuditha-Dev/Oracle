# Keep actual credentials in backend/.env, which is ignored by Git.
AI_PROVIDER=ollama
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_VISION_MODEL=moondream
OLLAMA_BASE_URL=http://127.0.0.1:11434

GEMINI_ENABLED=false
# Optional self-hosted search; JSON format must be enabled in SearXNG.
# Leave blank if no local instance is running. No public-instance fallback.
ORACLE_SEARXNG_URL=
# Non-secret identifier only; the OAuth client file stays at backend/google-client.json (ignored).
ORACLE_GOOGLE_PROJECT_ID=
# Set only after the public policy site is reviewed and published.
ORACLE_PUBLIC_SITE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
ORACLE_ALLOWED_APPS=
# Optional absolute path to the Oracle Pet executable.
ORACLE_PET_EXECUTABLE=
ORACLE_DATABASE_URL=
# Each OSRM URL must point to an instance built for that travel mode.
# Driving defaults to the public OSRM server. Walking and cycling require configuration.
ORACLE_OSRM_DRIVING_URL=
ORACLE_OSRM_WALKING_URL=
ORACLE_OSRM_CYCLING_URL=
# Optional road-network reachability. Atlas labels the geometric estimate when unavailable.
ORACLE_VALHALLA_URL=
# Optional Valhalla instance with traffic tiles for time-dependent driving.
ORACLE_VALHALLA_TRAFFIC_URL=
# Optional local geocoding instance for offline place lookup.
ORACLE_NOMINATIM_URL=
# Local voice: model is lazy-loaded; clean audio is the default baseline.
ORACLE_VOICE_MODEL=
ORACLE_VOICE_LANGUAGE=en
ORACLE_VOICE_DEVICE=auto
ORACLE_VOICE_COMPUTE_TYPE=auto
ORACLE_VOICE_PREPROCESS=false
# Product lookup is local by default. Online lookup requires an explicit request flag.
ORACLE_PRODUCT_ONLINE=false
# Provision with scripts/manage_postgres.py --provision; migrate/activate with scripts/migrate_records.py --activate.
# Keep the actual PostgreSQL connection URL server-side. Blank retains SQLite for compatibility.
# Optional comma separated executable names approved for launch; no paths or arguments.
# The separate local gateway credential is generated in data/dev/api-token.
